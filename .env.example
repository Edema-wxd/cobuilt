# CoBuilt backend configuration.
# Copy to .env.local for development. Every variable is declared and validated
# in src/lib/env.ts; the app refuses to boot in production with any of
# DATABASE_URL, REDIS_URL, NEON_AUTH_BASE_URL, NEON_AUTH_JWKS_URL or
# ALLOWED_ORIGINS missing.

NODE_ENV=development
LOG_LEVEL=info

# --- Data stores -------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cobuilt
DATABASE_POOL_MAX=10
DATABASE_SSL=false
REDIS_URL=redis://localhost:6379/0
# Integration tests only. The suites drop and rebuild `public` in this database
# on every run, so it must not be a database holding anything you want to keep.
# Unset, those suites skip and `npm test` still passes. See README § Testing.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cobuilt_test

# --- Search ------------------------------------------------------------------
# Leave unset to run search on PostgreSQL full-text instead of Meilisearch.
# MEILISEARCH_URL=http://localhost:7700
# MEILISEARCH_KEY=

# --- Auth --------------------------------------------------------------------
# Identity is Neon Auth. `neon deploy` writes the first two into .env.local;
# NEXT_PUBLIC_NEON_AUTH_URL is the same URL as NEON_AUTH_BASE_URL, exposed to
# the admin console's browser code.
# NEON_AUTH_BASE_URL=
# NEON_AUTH_JWKS_URL=
# NEXT_PUBLIC_NEON_AUTH_URL=

# --- Web ---------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_WEBSITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000

# --- Mail --------------------------------------------------------------------
# log | sendgrid | mailgun    (ses is not implemented — see docs/decisions.md)
MAIL_PROVIDER=log
MAIL_FROM=no-reply@cobuilt.com
MAIL_FROM_NAME=CoBuilt Investment Partners
ADMIN_EMAIL=admin@cobuilt.com
LEGAL_EMAIL=legal@cobuilt.com
# SENDGRID_API_KEY=
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=

# --- Object storage ----------------------------------------------------------
# Create a token in the UploadThing dashboard. Uploads fail with 503 without it.
# UPLOADTHING_TOKEN=
MAX_TOUR_UPLOAD_BYTES=52428800

# --- CMS ---------------------------------------------------------------------
CMS_SOURCE=strapi
# STRAPI_API_URL=https://cms.cobuilt.com
# STRAPI_API_TOKEN=
# Shared secret for POST /api/integrations/cms-webhooks.
# CMS_WEBHOOK_SECRET=

# --- Integrations ------------------------------------------------------------
# WHATSAPP_WEBHOOK_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# CHAT_WEBHOOK_SECRET=
# AKISMET_API_KEY=

# --- Observability -----------------------------------------------------------
# SENTRY_DSN=

# --- NDPA retention (days) ---------------------------------------------------
RETENTION_FORM_SUBMISSION_DAYS=90
RETENTION_INVESTOR_INQUIRY_DAYS=730
RETENTION_PAGE_VIEW_DAYS=30
