# CoBuilt backend configuration.
# Copy to .env.local for development. Every variable is declared and validated
# in src/lib/env.ts; the app refuses to boot in production with any of
# DATABASE_URL, REDIS_URL, JWT_SECRET or ALLOWED_ORIGINS missing.

NODE_ENV=development
LOG_LEVEL=info

# --- Data stores -------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cobuilt
DATABASE_POOL_MAX=10
DATABASE_SSL=false
REDIS_URL=redis://localhost:6379/0

# --- Search ------------------------------------------------------------------
# Leave unset to run search on PostgreSQL full-text instead of Meilisearch.
# MEILISEARCH_URL=http://localhost:7700
# MEILISEARCH_KEY=

# --- Auth --------------------------------------------------------------------
# Minimum 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-at-least-32-random-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
JWT_ISSUER=cobuilt-api
JWT_AUDIENCE=cobuilt-web

# --- Web ---------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_WEBSITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000

# --- Mail --------------------------------------------------------------------
# log | sendgrid | mailgun    (ses is not implemented — see docs/decisions.md)
MAIL_PROVIDER=log
MAIL_FROM=no-reply@cobuilt.com
MAIL_FROM_NAME=CoBuilt Investment Partners
ADMIN_EMAIL=admin@cobuilt.com
LEGAL_EMAIL=legal@cobuilt.com
# SENDGRID_API_KEY=
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=

# --- Object storage ----------------------------------------------------------
S3_BUCKET=cobuilt-tours
S3_REGION=us-east-1
# Set for DigitalOcean Spaces or another S3-compatible store.
# S3_ENDPOINT=https://lon1.digitaloceanspaces.com
# S3_FORCE_PATH_STYLE=false
# S3_PUBLIC_BASE_URL=https://cdn.cobuilt.com
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
MAX_TOUR_UPLOAD_BYTES=52428800

# --- CMS ---------------------------------------------------------------------
CMS_SOURCE=strapi
# STRAPI_API_URL=https://cms.cobuilt.com
# STRAPI_API_TOKEN=
# Shared secret for POST /api/integrations/cms-webhooks.
# CMS_WEBHOOK_SECRET=

# --- Integrations ------------------------------------------------------------
# WHATSAPP_WEBHOOK_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# CHAT_WEBHOOK_SECRET=
# AKISMET_API_KEY=

# --- Observability -----------------------------------------------------------
# SENTRY_DSN=

# --- Monitoring and alerts (worker host) -------------------------------------
# Each app server's /api/health plus the public one; see docs/deployment.md.
# HEALTHCHECK_URLS=http://10.0.0.11:3000/api/health,https://cobuilt.com/api/health
HEALTHCHECK_INTERVAL_SECONDS=60
# Slack-compatible incoming webhook, and/or an inbox (needs a real MAIL_PROVIDER).
# ALERT_WEBHOOK_URL=
# ALERT_EMAIL=ops@cobuilt.com
ALERT_REPEAT_HOURS=4

# --- Backups (worker host) ----------------------------------------------------
# Unset disables backups and the freshness check.
# BACKUP_DIR=/var/backups/cobuilt
BACKUP_RETENTION_DAYS=7
BACKUP_MAX_AGE_HOURS=26
# Scratch database for the weekly restore check. It is wiped on every run.
# RESTORE_CHECK_DATABASE_URL=postgresql://restore_check:...@localhost:5432/cobuilt_restore_check

# --- NDPA retention (days) ---------------------------------------------------
RETENTION_FORM_SUBMISSION_DAYS=90
RETENTION_INVESTOR_INQUIRY_DAYS=730
RETENTION_PAGE_VIEW_DAYS=30
# WhatsApp and live chat messages
RETENTION_MESSAGE_DAYS=90
